KIBAN_DOMAIN=kiban.example.jp
KIBAN_ACME_EMAIL=operations@example.jp
KIBAN_POSTGRES_DB=kiban
KIBAN_POSTGRES_USER=kiban
KIBAN_POSTGRES_PASSWORD_FILE=./secrets/postgres_password
KIBAN_POSTGRES_DSN_FILE=./secrets/postgres_dsn
KIBAN_OIDC_ISSUER=https://id.example.jp/tenant
KIBAN_OIDC_AUDIENCE=kiban-api
KIBAN_OIDC_JWKS_URL=https://id.example.jp/tenant/.well-known/jwks.json
KIBAN_OIDC_AUTHORIZATION_URL=https://id.example.jp/tenant/authorize
KIBAN_OIDC_TOKEN_URL=https://id.example.jp/tenant/token
KIBAN_OIDC_CLIENT_ID=yosoku-kiban-ui
KIBAN_OIDC_SCOPES=openid profile
KIBAN_OIDC_ROLE_CLAIM=roles
KIBAN_OIDC_ROLE_MAPPING={"kiban-viewer":"VIEWER","kiban-analyst":"ANALYST","kiban-approver":"APPROVER","kiban-admin":"ADMIN"}
KIBAN_OIDC_ALGORITHMS=RS256
KIBAN_OIDC_LEEWAY_SECONDS=60
KIBAN_SNAPSHOT_DIR=../snapshot_input
KIBAN_REPORT_DIR=../report_output
KIBAN_CONFORMANCE_DIR=/srv/kiban/provider-conformance
KIBAN_IMPORT_DIR=../import_input
KIBAN_RAW_ARCHIVE_DIR=../raw_archive
KIBAN_ACCEPTANCE_DIR=../acceptance_output
KIBAN_PREFLIGHT_DIR=/srv/kiban/preflight
KIBAN_OIDC_PREFLIGHT_DIR=/srv/kiban/oidc-preflight
KIBAN_MAPPING_SOURCE=sample.csv
KIBAN_MAPPING_FILE=./mapping.example.json
KIBAN_MAPPING_SAMPLE_ROWS=1000
KIBAN_MAPPING_MAX_SOURCE_BYTES=100000000
KIBAN_MAPPING_DRY_RUN_DIR=/srv/kiban/mapping-dry-run
KIBAN_BACKUP_DIR=./backups
KIBAN_RECOVERY_REPORT_DIR=./recovery-reports
KIBAN_TIMESFM_DIR=/srv/kiban/timesfm
KIBAN_TIMESFM_BENCHMARK_DIR=/srv/kiban/timesfm-benchmarks
KIBAN_TIMESFM_CPUS=2.0
KIBAN_TIMESFM_MEMORY=4G
KIBAN_TIMESFM_MEMORY_BYTES=4294967296
