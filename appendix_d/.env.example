KIBAN_AUTH_MODE=token
KIBAN_API_TOKEN=replace-with-local-development-token
KIBAN_API_SUBJECT=local-admin
KIBAN_DEPLOYMENT_MODE=development
KIBAN_ALLOWED_HOSTS=127.0.0.1,localhost,api
# productionではKIBAN_API_TOKENを削除し、32文字以上のtokenをsecretから設定する。
# KIBAN_API_CREDENTIALS=[{"token":"replace-with-at-least-32-characters","subject":"user@example.jp","roles":["VIEWER"]}]
# KIBAN_API_CREDENTIALS_FILE=/run/secrets/api_credentials
# KIBAN_CREDENTIAL_REFRESH_SECONDS=5
# OIDC mode: KIBAN_AUTH_MODE=oidc
# KIBAN_OIDC_ISSUER=https://id.example.jp/tenant
# KIBAN_OIDC_AUDIENCE=kiban-api
# KIBAN_OIDC_JWKS_URL=https://id.example.jp/tenant/.well-known/jwks.json
# KIBAN_OIDC_ROLE_CLAIM=roles
# KIBAN_OIDC_ROLE_MAPPING={"kiban-viewer":"VIEWER","kiban-admin":"ADMIN"}
# KIBAN_OIDC_ALGORITHMS=RS256
# KIBAN_OIDC_LEEWAY_SECONDS=60
# KIBAN_OIDC_AUTHORIZATION_URL=https://id.example.jp/tenant/authorize
# KIBAN_OIDC_TOKEN_URL=https://id.example.jp/tenant/token
# KIBAN_OIDC_CLIENT_ID=yosoku-kiban-ui
# KIBAN_OIDC_SCOPES=openid profile
# KIBAN_OIDC_PREFLIGHT_DIR=./oidc_preflight_output
KIBAN_EXECUTOR=deployment.executor:execute
KIBAN_POSTGRES_DSN=postgresql://kiban:local-development-only@127.0.0.1:55432/kiban
# KIBAN_POSTGRES_DSN_FILE=/run/secrets/postgres_dsn
KIBAN_SNAPSHOT_ROOT=./snapshot_input
KIBAN_SNAPSHOT_DIR=./snapshot_input
KIBAN_REPORT_ROOT=./report_output
KIBAN_REPORT_DIR=./report_output
KIBAN_IMPORT_DIR=./import_input
KIBAN_RAW_ARCHIVE_DIR=./raw_archive
# mappingドライラン: input root内の相対path、mapping JSON、証跡保存先
# KIBAN_MAPPING_SOURCE=sample.csv
# KIBAN_MAPPING_FILE=./deploy/mapping.example.json
# KIBAN_MAPPING_SAMPLE_ROWS=1000
# KIBAN_MAPPING_MAX_SOURCE_BYTES=100000000
# KIBAN_MAPPING_DRY_RUN_DIR=./mapping_dry_run_output
