KIBAN_API_TOKEN=replace-with-local-development-token
KIBAN_API_SUBJECT=local-admin
KIBAN_DEPLOYMENT_MODE=development
KIBAN_ALLOWED_HOSTS=127.0.0.1,localhost,api
# productionではKIBAN_API_TOKENを削除し、32文字以上のtokenをsecretから設定する。
# KIBAN_API_CREDENTIALS=[{"token":"replace-with-at-least-32-characters","subject":"user@example.jp","roles":["VIEWER"]}]
KIBAN_EXECUTOR=deployment.executor:execute
KIBAN_POSTGRES_DSN=postgresql://kiban:local-development-only@127.0.0.1:55432/kiban
KIBAN_SNAPSHOT_ROOT=./snapshot_input
KIBAN_SNAPSHOT_DIR=./snapshot_input
KIBAN_REPORT_ROOT=./report_output
KIBAN_REPORT_DIR=./report_output
KIBAN_IMPORT_DIR=./import_input
KIBAN_RAW_ARCHIVE_DIR=./raw_archive
